# Copy to /opt/plaud-exporter/.env on the server (chmod 600). Do not commit .env.

# Rolling deploy updates this (CI or manual):
APP_IMAGE=ghcr.io/OWNER/plaud-server-exporter:latest

# Loopback port for host nginx → container (must match deploy/ansible vars):
WEBAPP_HOST_PORT=18080

# Host path bind-mounted into the container for Markdown exports:
PLAUD_EXPORTS_HOST_DIR=/srv/plaud-exporter/exports

# --- Plaud (required) ---
PLAUD_EXPORT_ROOT=/app/exports
PLAUD_TIMEZONE=Europe/Moscow
PLAUD_LOG_LEVEL=info
PLAUD_MIRROR_FOLDERS=true

# --- Telegram bot (required for container CMD) ---
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_ALLOWED_USER_ID=123456789
TELEGRAM_ALLOWED_USERNAME=your_username
BOT_SYNC_INTERVAL_MIN=120
BOT_LONG_POLL_SEC=30

# Public HTTPS URL for future Web App (nginx /connect):
WEBAPP_BASE_URL=https://your-domain.example/connect

# Optional: external Obsidian vault on host (bind-mount that path as exports or set vault path)
# PLAUD_OBSIDIAN_VAULT_PATH=/path/on/host/vault
