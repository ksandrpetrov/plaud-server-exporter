# Managed by Ansible — edit secrets on server only; re-run playbook preserves keys.
#
# Anything `config.js` reads and that changes where files land MUST be renderable
# here. A key that exists on the old host but not in this template silently
# reverts to its default after the cutover — e.g. dropping
# PLAUD_OBSIDIAN_SUBFOLDER moves every summary into `Plaud/` and makes the next
# sync rename the whole vault. Before switching a host over, diff its current
# .env against this file.
APP_IMAGE={{ app_image_effective }}
WEBAPP_HOST_PORT={{ webapp_host_port }}
PLAUD_EXPORTS_HOST_DIR={{ plaud_exports_host_dir }}

PLAUD_EXPORT_ROOT=/app/exports
PLAUD_TIMEZONE={{ plaud_timezone | default('UTC') }}
PLAUD_LOG_LEVEL={{ plaud_log_level | default('info') }}
PLAUD_MIRROR_FOLDERS={{ plaud_mirror_folders | default('true') }}
{% if plaud_obsidian_subfolder is defined and plaud_obsidian_subfolder | length > 0 %}
PLAUD_OBSIDIAN_SUBFOLDER={{ plaud_obsidian_subfolder }}
{% endif %}
{% if plaud_obsidian_vault_path is defined and plaud_obsidian_vault_path | length > 0 %}
PLAUD_OBSIDIAN_VAULT_PATH={{ plaud_obsidian_vault_path }}
{% endif %}
{% if plaud_auth_mode is defined and plaud_auth_mode | length > 0 %}
PLAUD_AUTH_MODE={{ plaud_auth_mode }}
{% endif %}
{% if plaud_api_mode is defined and plaud_api_mode | length > 0 %}
PLAUD_API_MODE={{ plaud_api_mode }}
{% endif %}

TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}
TELEGRAM_ALLOWED_USER_ID={{ telegram_allowed_user_id | default('') }}
TELEGRAM_ALLOWED_USERNAME={{ telegram_allowed_username | default('') }}
BOT_SYNC_INTERVAL_MIN={{ bot_sync_interval_min | default('120') }}
BOT_LONG_POLL_SEC={{ bot_long_poll_sec | default('30') }}

WEBAPP_BASE_URL={{ webapp_base_url | default('') }}
