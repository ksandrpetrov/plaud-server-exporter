[Unit]
Description=Plaud Server Exporter — Telegram bot (long-polling + scheduled sync)
Documentation=file:///srv/plaud-exporter/docs/server-deploy.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=plaud
Group=plaud
WorkingDirectory=/srv/plaud-exporter
EnvironmentFile=/srv/plaud-exporter/.env
ExecStart=/usr/bin/env npm run --silent server:bot
Restart=always
RestartSec=5
StandardOutput=append:/var/log/plaud-exporter/bot.log
StandardError=append:/var/log/plaud-exporter/bot.log
Environment=NODE_ENV=production
Nice=10

# Hardening
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/plaud-exporter /var/log/plaud-exporter
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true

[Install]
WantedBy=multi-user.target
