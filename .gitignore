owner-chat.json
bot-settings.json

# Playwright profile (browser state with cookies/localStorage)
playwright-profile/
.playwright/

# Test / coverage output (lcov.info files are generated by `npm run test:coverage`)
coverage/
.nyc_output/

# Build / cache artefacts
dist/
build/
.cache/
.tmp/
tmp/
*.tsbuildinfo

