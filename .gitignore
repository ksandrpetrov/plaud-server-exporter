# Dependencies
node_modules/
.npm/
.yarn/
.pnpm-store/

# Environment / secrets
.env
.env.*
!.env.example
*.local

# Runtime data (sessions, sync index, playwright profile, exports, logs)
server/.data/
.data/
exports/
logs/
*.log

# Session snapshots and tokens (never commit)
session*.json
*-session.json
*-tokens.json

# Telegram bot runtime state (also lives under server/.data/, kept as defence-in-depth)
telegram-offset.json
owner-chat.json
bot-settings.json

# Playwright profile (browser state with cookies/localStorage)
playwright-profile/
.playwright/

# Test / coverage output (lcov.info files are generated by `npm run test:coverage`)
coverage/
.nyc_output/

# Build / cache artefacts
dist/
build/
.cache/
.tmp/
tmp/
*.tsbuildinfo

# Backups
*.bak
*.orig

# OS / editor
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
