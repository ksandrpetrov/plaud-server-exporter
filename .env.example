# Скопируйте в .env в корне репозитория. Не коммитьте .env.

# Обязательно на сервере; на Mac для проверки — любой локальный путь
PLAUD_EXPORT_ROOT=/srv/plaud-exporter/exports

# IANA timezone для дат в именах файлов
PLAUD_TIMEZONE=UTC

# Подпапка под vault (по умолчанию Plaud)
PLAUD_OBSIDIAN_SUBFOLDER=Plaud

# Отражать теги папок Plaud в пути (true/false)
PLAUD_MIRROR_FOLDERS=true

PLAUD_LOG_LEVEL=info

# Опционально: писать в существующий vault Obsidian вместо PLAUD_EXPORT_ROOT
# PLAUD_OBSIDIAN_VAULT_PATH=/Users/you/Obsidian/MyVault

# Опционально: переопределить каталог server/.data
# PLAUD_DATA_DIR=/srv/plaud-exporter/server/.data

# PLAUD_API_CONCURRENCY=4
# PLAUD_WEB_ORIGIN=https://web.plaud.ai

# --- Telegram-бот (обязательно на VPS для server:bot / plaud-exporter.service) ---
# Токен от @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
# Username владельца без @ (lowercase)
# TELEGRAM_ALLOWED_USERNAME=your_username
# Числовой user_id владельца (стабильный, в отличие от username — рекомендуется задать).
# Узнать можно у @userinfobot или из getUpdates после первого /start.
# Если задан — бот будет принимать команды ТОЛЬКО при совпадении этого id.
# TELEGRAM_ALLOWED_USER_ID=123456789
# Интервал автосинка в минутах (по умолчанию 120)
# BOT_SYNC_INTERVAL_MIN=120
# Таймаут long-polling getUpdates в секундах (по умолчанию 30)
# BOT_LONG_POLL_SEC=30
