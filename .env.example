# Copy this file to .env and adjust the values.
# Do NOT commit your real .env — it is gitignored.

# ---- Output ----------------------------------------------------------------
# Where the server writes exports if no vault is configured.
# Omit PLAUD_EXPORT_ROOT to use <repo>/exports (good for local Mac dev).
# PLAUD_EXPORT_ROOT=/srv/plaud-exporter/exports

# Optional: write directly into a local Obsidian vault. When set, files go to
# {PLAUD_OBSIDIAN_VAULT_PATH}/{PLAUD_OBSIDIAN_SUBFOLDER}/{YYYY}/...
# When unset, exports go under PLAUD_EXPORT_ROOT instead.
# PLAUD_OBSIDIAN_VAULT_PATH=/path/to/your/obsidian-vault
PLAUD_OBSIDIAN_SUBFOLDER=Plaud

# ---- Behavior --------------------------------------------------------------
# Default is summary-only. To enable audio via env (without --audio-too),
# you must explicitly set BOTH:
#   PLAUD_EXPORT_SUMMARY_ONLY=false
#   PLAUD_EXPORT_AUDIO=true
# The CLI flags --audio-too / --no-audio always override the env.
PLAUD_EXPORT_SUMMARY_ONLY=true
PLAUD_EXPORT_AUDIO=false
PLAUD_TIMEZONE=Europe/Moscow

# Mirror Plaud Folders into {PLAUD_OBSIDIAN_SUBFOLDER}/{FolderName}/{YYYY}/...
PLAUD_MIRROR_FOLDERS=true

# ---- API client tuning -----------------------------------------------------
# PLAUD_API_CONCURRENCY=4
# PLAUD_API_TIMEOUT_MS=45000
# PLAUD_API_MAX_RETRIES=3
# PLAUD_API_PAGE_LIMIT=100
# PLAUD_API_MAX_FILES=5000

# ---- Paths -----------------------------------------------------------------
# All default to server/.data/, which is gitignored.
# PLAUD_DATA_DIR=/srv/plaud-exporter/server/.data
# PLAUD_SESSION_PATH=/srv/plaud-exporter/server/.data/session.json
# PLAUD_SYNC_INDEX_PATH=/srv/plaud-exporter/server/.data/sync-index.json
# PLAUD_STATUS_PATH=/srv/plaud-exporter/server/.data/status.json
# PLAUD_PLAYWRIGHT_PROFILE_DIR=/srv/plaud-exporter/server/.data/playwright-profile

# ---- Playwright browser ----------------------------------------------------
# By default `server:auth` launches your installed Google Chrome because
# Google blocks sign-in from Playwright's bundled Chromium with
# "this browser may not be secure". Override only if you know what you do:
# PLAUD_PLAYWRIGHT_CHANNEL=chrome     # default; uses installed Chrome
# PLAUD_PLAYWRIGHT_CHANNEL=chromium   # use the bundled Chromium (Google may block)
# PLAUD_PLAYWRIGHT_CHANNEL=msedge     # use Microsoft Edge
# PLAUD_PLAYWRIGHT_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ---- Logging ---------------------------------------------------------------
# Levels: debug, info, warn, error
PLAUD_LOG_LEVEL=info
